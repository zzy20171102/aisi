{
  "schema": "aisi.composition/1",
  "modules": [
    {"id": "MOD-00", "name": "人力资源管理系统", "kind": "subsystem", "parent": "", "responsibilities": ["系统级功能、性能与部署目标承载", "端到端人事业务闭环"], "requirements": ["REQ-001", "REQ-002", "REQ-002.1", "REQ-002.2", "REQ-004", "REQ-004.1", "REQ-004.2", "REQ-004.3", "REQ-004.4", "REQ-004.5"], "notes": "B/S 架构整体；六大功能模块对应人事工作基本流程（样例报告 §二）；系统级需求（性能/部署）由整体承载"},
    {"id": "MOD-01", "name": "员工资料管理子系统", "kind": "subsystem", "parent": "MOD-00", "responsibilities": ["员工基本资料与高级资料管理"], "requirements": ["REQ-001.1"], "notes": ""},
    {"id": "MOD-11", "name": "基本资料管理模块", "kind": "module", "parent": "MOD-01", "layer": "LAY-01", "responsibilities": ["档案增删改查（按id更新）", "工号自动生成", "必填项校验", "多条件搜索"], "requirements": ["REQ-001.1.1", "REQ-001.1.1.1", "REQ-001.1.1.2", "REQ-001.1.1.3", "REQ-001.1.1.4"], "notes": "员工实体与奖惩 1:N、与调动 1:N、与在训 1:1、与考评 1:1（样例报告 §4/§5/§6）"},
    {"id": "MOD-12", "name": "高级资料查询模块", "kind": "module", "parent": "MOD-01", "layer": "LAY-01", "responsibilities": ["培训资料查询", "考评资料查询", "工资信息查询"], "requirements": ["REQ-001.1.2", "REQ-001.1.2.1", "REQ-001.1.2.2", "REQ-001.1.2.3"], "notes": "高级资料 = 培训 + 考评 + 工资三部分（样例报告 §4.3.2）"},
    {"id": "MOD-02", "name": "员工奖惩管理子系统", "kind": "subsystem", "parent": "MOD-00", "responsibilities": ["奖惩记录全生命周期管理"], "requirements": ["REQ-001.2"], "notes": "员工与奖惩信息一对多"},
    {"id": "MOD-21", "name": "添加奖惩模块", "kind": "module", "parent": "MOD-02", "layer": "LAY-01", "responsibilities": ["为员工添加奖惩记录，同一员工可多条"], "requirements": ["REQ-001.2.1"], "provided_interfaces": [], "used_interfaces": [], "notes": "UI 使用穿梭框与 tab 标签"},
    {"id": "MOD-22", "name": "奖惩管理列表模块", "kind": "module", "parent": "MOD-02", "layer": "LAY-01", "responsibilities": ["展示有奖惩信息的全部员工", "查看奖惩详情"], "requirements": ["REQ-001.2.2"], "notes": ""},
    {"id": "MOD-03", "name": "员工培训与考评子系统", "kind": "subsystem", "parent": "MOD-00", "responsibilities": ["培训业务与评价业务管理"], "requirements": ["REQ-001.3"], "notes": ""},
    {"id": "MOD-31", "name": "培训管理模块", "kind": "module", "parent": "MOD-03", "layer": "LAY-01", "responsibilities": ["批量添加培训", "在训唯一约束（同期仅1个）", "培训进度维护（进度条）"], "requirements": ["REQ-001.3.1", "REQ-001.3.1.1", "REQ-001.3.1.2", "REQ-001.3.1.3"], "notes": "培训完成删除当前培训后方可添加新培训"},
    {"id": "MOD-32", "name": "考评管理模块", "kind": "module", "parent": "MOD-03", "layer": "LAY-01", "responsibilities": ["批量添加评价（评分条/步骤条）", "考评增删改查"], "requirements": ["REQ-001.3.2", "REQ-001.3.2.1"], "notes": "员工与考评一对一"},
    {"id": "MOD-04", "name": "员工调动管理模块", "kind": "module", "parent": "MOD-00", "layer": "LAY-01", "responsibilities": ["调动信息增删改查"], "requirements": ["REQ-001.4"], "notes": "员工与调动一对多；UI 为 table 内嵌 table"},
    {"id": "MOD-05", "name": "薪资管理子系统", "kind": "subsystem", "parent": "MOD-00", "responsibilities": ["工资账套、员工账套、工资表管理"], "requirements": ["REQ-001.5"], "notes": ""},
    {"id": "MOD-51", "name": "工资账套管理模块", "kind": "module", "parent": "MOD-05", "layer": "LAY-01", "responsibilities": ["奖金/基本工资/提成各项增删改查", "设置当前套账"], "requirements": ["REQ-001.5.1"], "notes": ""},
    {"id": "MOD-52", "name": "员工账套设置模块", "kind": "module", "parent": "MOD-05", "layer": "LAY-01", "responsibilities": ["为员工设置工资账套"], "requirements": ["REQ-001.5.2"], "notes": ""},
    {"id": "MOD-53", "name": "工资表管理模块", "kind": "module", "parent": "MOD-05", "layer": "LAY-01", "responsibilities": ["工资搜索查看", "按职称/部门表内筛选", "套账详情查看"], "requirements": ["REQ-001.5.3"], "notes": ""},
    {"id": "MOD-06", "name": "统计分析子系统", "kind": "subsystem", "parent": "MOD-00", "responsibilities": ["积分统计与人事分析"], "requirements": ["REQ-001.6"], "notes": ""},
    {"id": "MOD-61", "name": "员工积分统计模块", "kind": "module", "parent": "MOD-06", "layer": "LAY-01", "responsibilities": ["按工号查积分", "条形图展示积分分布"], "requirements": ["REQ-001.6.1"], "notes": "积分分值由奖惩产生（依赖 MOD-02 数据）"},
    {"id": "MOD-62", "name": "人事信息分析模块", "kind": "module", "parent": "MOD-06", "layer": "LAY-01", "responsibilities": ["饼图人员分布：高校/职称/职位/党派/民族/学历/部门"], "requirements": ["REQ-001.6.2"], "notes": ""},
    {"id": "MOD-63", "name": "人事记录分析模块", "kind": "module", "parent": "MOD-06", "layer": "LAY-01", "responsibilities": ["离职率/离职工龄/离职年龄分析（柱状+折线）"], "requirements": ["REQ-001.6.3"], "notes": ""},
    {"id": "MOD-07", "name": "人事通讯模块", "kind": "module", "parent": "MOD-00", "layer": "LAY-01", "responsibilities": ["操作员间点对点在线讯息"], "requirements": ["REQ-001.7"], "notes": "依赖 WebSocket 接口（IF 见流程视图）"},
    {"id": "MOD-08", "name": "基础信息设置子系统", "kind": "subsystem", "parent": "MOD-00", "responsibilities": ["部门/职位/职称/奖惩规则/权限组管理"], "requirements": ["REQ-001.8"], "notes": ""},
    {"id": "MOD-81", "name": "部门管理模块", "kind": "module", "parent": "MOD-08", "layer": "LAY-01", "responsibilities": ["部门增删查改", "部门树展示"], "requirements": ["REQ-001.8.1"], "notes": ""},
    {"id": "MOD-82", "name": "职位管理模块", "kind": "module", "parent": "MOD-08", "layer": "LAY-01", "responsibilities": ["职位增删查改"], "requirements": ["REQ-001.8.2"], "notes": ""},
    {"id": "MOD-83", "name": "职称管理模块", "kind": "module", "parent": "MOD-08", "layer": "LAY-01", "responsibilities": ["职称信息管理（细节待澄清）"], "requirements": ["REQ-001.8.3"], "notes": "对应待澄清项：是否与职位管理同构"},
    {"id": "MOD-84", "name": "奖惩规则管理模块", "kind": "module", "parent": "MOD-08", "layer": "LAY-01", "responsibilities": ["奖惩规则设置与管理"], "requirements": ["REQ-001.8.4"], "notes": "为 MOD-02 提供规则基础数据"},
    {"id": "MOD-85", "name": "权限组管理模块", "kind": "module", "parent": "MOD-08", "layer": "LAY-01", "responsibilities": ["权限组设置", "权限树展示"], "requirements": ["REQ-001.8.5"], "notes": "为 MOD-10 RBAC 服务提供权限基础数据"},
    {"id": "MOD-09", "name": "系统管理子系统", "kind": "subsystem", "parent": "MOD-00", "responsibilities": ["操作员管理与授权处理"], "requirements": ["REQ-001.9"], "notes": ""},
    {"id": "MOD-91", "name": "操作员管理模块", "kind": "module", "parent": "MOD-09", "layer": "LAY-01", "responsibilities": ["操作员管理", "为用户授予角色"], "requirements": ["REQ-001.9.1"], "notes": ""},
    {"id": "MOD-92", "name": "菜单权限配置模块", "kind": "module", "parent": "MOD-09", "layer": "LAY-01", "responsibilities": ["按角色分配菜单权限", "前端默认不加载无权限菜单"], "requirements": ["REQ-001.9.2"], "notes": ""},
    {"id": "MOD-10", "name": "RBAC 安全服务", "kind": "service", "parent": "MOD-00", "layer": "LAY-03", "responsibilities": ["身份验证（自定义+表单验证）", "RBAC 鉴权（URL 直达拦截）", "操作审计日志", "保密级别授权"], "requirements": ["REQ-005", "REQ-005.1", "REQ-005.2", "REQ-005.3", "REQ-005.4"], "notes": "基于 RBAC0 模型（用户/角色映射/角色/权限/权限映射五表）；横切各业务模块"},
    {"id": "MOD-20", "name": "数据持久层", "kind": "database", "parent": "MOD-00", "layer": "LAY-04", "responsibilities": ["员工主数据（1:N/1:1 关系）", "RBAC 五表数据", "培训考评数据", "薪资账套数据", "奖惩积分数据", "统计维度数据", "基础信息数据", "Excel 交换"], "requirements": ["REQ-003", "REQ-003.1", "REQ-003.2", "REQ-003.3", "REQ-003.4", "REQ-003.5", "REQ-003.6", "REQ-003.7", "REQ-003.8"], "notes": "MySQL 8.0 存储；工号由数据库自动生成"},
    {"id": "MOD-40", "name": "前后端交互服务", "kind": "service", "parent": "MOD-00", "layer": "LAY-02", "responsibilities": ["HTTP 前后端数据接口", "WebSocket 在线讯息接口", "Excel 导入导出接口"], "requirements": ["REQ-006", "REQ-006.1", "REQ-006.2", "REQ-006.3"], "notes": "前后端仅数据交互，页面跳转由前端路由处理"}
  ]
}
