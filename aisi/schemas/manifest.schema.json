{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aisi.system.manifest/1",
  "title": "AISI 系统清单",
  "type": "object",
  "required": ["schema", "system_id", "name", "domain", "profile", "created", "updated"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "aisi.system.manifest/1" },
    "system_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "domain": { "enum": ["airborne", "aerospace", "information-system", "software", "other"] },
    "profile": { "enum": ["gjb438c", "gb8567", "custom"] },
    "standards": { "type": "array", "items": { "type": "string" } },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
  }
}
